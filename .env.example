# Copy to .env and fill in. .env is gitignored.

# SAIA API key (GWDG academic AI service)
SAIA_API_KEY=

# Base URL of a running GPU server (cluster/gpu_server.py) reachable from
# this machine. Examples:
#   same machine, SSH tunnel to the cluster:    http://host.docker.internal:8000
#   GPU server directly reachable:              http://<gpu-host>:8000
GPU_REMOTE_URL=
